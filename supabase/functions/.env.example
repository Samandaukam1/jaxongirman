# Server-side only. Copy to supabase/functions/.env for local real-mode work.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
GENERATION_MODE=real
IMAGE_SEARCH_API_KEY=

# Marketplace payments ------------------------------------------------------
# Leave PAYME_ID and PAYME_KEY unset until the merchant account exists.
# PAYME_ID=
# PAYME_KEY=
# PAYME_ENDPOINT=https://checkout.paycom.uz/api
#
# Development stand-in. Only takes effect when BOTH are true:
#   PAYMENT_MODE=sandbox here, and payments.config.configured = false in the
#   database. Every sandbox purchase is flagged is_sandbox and is excluded from
#   revenue, seller earnings and settlements. Never set this in production.
# PAYMENT_MODE=sandbox

# The site builds web/ and the browser app from user/. Keep their source,
# assets, config and shared packages; leave font sources, mascot work and native
# projects off the upload. Both app manifests stay because npm reads every
# workspace named by the root package.json.
/font-library
/output
/docs
/scripts
/supabase
/user/*
!/user/package.json
!/user/app.json
!/user/app.config.js
!/user/babel.config.js
!/user/metro.config.js
!/user/tsconfig.json
!/user/app/
!/user/app/**
!/user/src/
!/user/src/**
!/user/assets/
!/user/assets/**
!/user/types/
!/user/types/**
/admin/*
!/admin/package.json
/web/.next
/web/.vercel
/web/tests
/web/tsconfig.tsbuildinfo

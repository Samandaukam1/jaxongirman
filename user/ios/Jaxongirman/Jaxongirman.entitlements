<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Associated Domains: what makes a scanned https://<domain>/join/<token> QR
      open this app instead of Safari.

      Kept here rather than only in app.json because this project has a checked-in
      ios/ folder, and EAS Build does not sync app.json's `ios` block into an
      existing native project. Both places carry the same two domains, so a later
      `expo prebuild` produces this same file.

      The web side must serve /.well-known/apple-app-site-association naming
      <TeamID>.uz.jaxongirman.app — see web/public/.well-known/README.md.
    -->
    <key>com.apple.developer.associated-domains</key>
    <array>
      <string>applinks:jaxongirman.uz</string>
      <string>applinks:jaxongirman.app</string>
    </array>

    <!--
      Sign in with Apple. Without this entitlement the button presents itself
      and then fails at the moment somebody uses it, which is the worst place to
      discover a missing capability.

      Here for the same reason as the domains above: app.config.js sets
      `ios.usesAppleSignIn`, but EAS Build does not sync the `ios` block into a
      checked-in native project. Both places say the same thing, so a later
      `expo prebuild` reproduces this file rather than contradicting it.

      The matching capability must also be enabled on the App ID in the Apple
      Developer console — see docs/social-auth-setup.md.
    -->
    <key>com.apple.developer.applesignin</key>
    <array>
      <string>Default</string>
    </array>
  </dict>
</plist>

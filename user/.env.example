# Only EXPO_PUBLIC_* values are allowed in this client application.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In. Client IDs, not secrets — the OAuth client secret belongs in
# the Supabase dashboard and must never appear in an app bundle.
# Absent values are not an error: the Google button reports itself unconfigured.
# The iOS one is also read at build time to derive the URL scheme, so changing
# it needs a rebuild rather than a restart.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

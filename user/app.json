{
  "expo": {
    "name": "Jaxongirman",
    "slug": "jaxongirman",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "jaxongirman",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.jaxongirman.app",
      "associatedDomains": [
        "applinks:jaxongirman.uz",
        "applinks:jaxongirman.app"
      ],
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Jaxongirman development serverga ulanish uchun mahalliy tarmoqqa kirishga muhtoj."
      },
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "C56D.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyTracking": false
      }
    },
    "android": {
      "package": "uz.jaxongirman.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9FB"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jaxongirman.uz",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.app",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.uz",
              "pathPrefix": "/pair"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.app",
              "pathPrefix": "/pair"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.uz",
              "pathPrefix": "/game-pair"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.app",
              "pathPrefix": "/game-pair"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.uz",
              "pathPrefix": "/marathon"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.app",
              "pathPrefix": "/marathon"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.uz",
              "pathPrefix": "/web-login"
            },
            {
              "scheme": "https",
              "host": "jaxongirman.app",
              "pathPrefix": "/web-login"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Prezentatsiyadagi rasmlarni almashtirish uchun galereyaga kirish kerak."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Proyektordagi QR kodni skanerlash, test varag‘ini tekshirish va chatda video xabar yozish uchun kameraga kirish kerak.",
          "microphonePermission": "Chatda ovozli va video xabar yozish uchun mikrofonga kirish kerak.",
          "recordAudioAndroid": true
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-splash-screen",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Chatda ovozli xabar yozish uchun mikrofonga kirish kerak.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b8d05c9-d62f-4acd-9598-16ef588710e5"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

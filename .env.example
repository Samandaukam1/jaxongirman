# Client-safe values only. Copy the relevant keys into user/.env and admin/.env.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Set server secrets with `supabase secrets set` or supabase/functions/.env locally.
# Never copy these into Expo/Vite client environment files.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
GENERATION_MODE=real
IMAGE_SEARCH_API_KEY=
